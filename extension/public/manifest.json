{
  "manifest_version": 3,
  "name": "AI Video Discovery",
  "version": "0.1.0",
  "description": "Popularity-blind quality assessments and recommendations for YouTube videos, served by your AI Video Discovery backend.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Video Discovery"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "minimum_chrome_version": "120"
}
