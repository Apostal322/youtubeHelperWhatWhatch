# Copy to .env. Everything is optional: without credentials the system runs in the clearly
# labelled synthetic demo mode (heuristic baseline over synthetic fixtures).

# --- Evaluation provider: heuristic (default demo) | anthropic | openai_compatible
AVD_LLM_PROVIDER=heuristic
# AVD_ANTHROPIC_API_KEY=sk-ant-...
# AVD_LLM_MODEL_STAGE_B=claude-opus-5-5
# AVD_LLM_MODEL_STAGE_C=claude-opus-5-5
# AVD_LLM_EFFORT_STAGE_B=medium
# AVD_LLM_EFFORT_STAGE_C=high
# AVD_ANTHROPIC_REFUSAL_FALLBACK=true
# AVD_OPENAI_API_KEY=...
# AVD_OPENAI_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server
# AVD_LLM_PRICE_OVERRIDES=my-local-model=0:0

# --- Budget / rate limits
AVD_DAILY_LLM_BUDGET_USD=5.0
AVD_LLM_REQUESTS_PER_MINUTE=30

# --- YouTube Data API (discovery + metadata only; never media download)
# AVD_YOUTUBE_API_KEY=AIza...
AVD_YOUTUBE_DAILY_QUOTA_UNITS=10000

# --- Stage C retrieval fact checking: directory of licensed reference docs (*.txt + *.meta.json)
# AVD_REFERENCE_CORPUS_DIR=/data/reference_corpus

# --- Embeddings: hashing (offline default) | sentence_transformers (pip install '.[ml]')
AVD_EMBEDDING_PROVIDER=hashing

# --- API
AVD_ADMIN_TOKEN=change-me-local-admin
